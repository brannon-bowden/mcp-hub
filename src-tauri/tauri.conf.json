{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Hub",
  "version": "0.1.25",
  "identifier": "com.mcphub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCP Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "MCP Server Manager",
    "longDescription": "A centralized management interface for Model Context Protocol (MCP) servers. Configure MCP servers once and deploy to multiple AI client applications."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/brannon-bowden/mcp-hub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMzdBOTE5MUFFRkNFREUKUldUZXp1OGFHYWszUU9RZVN6NVpiUllaNHpLWjVYYmw1dGJiczVxNnprVHZ6MWQvL3hyMGtGTUwK"
    }
  }
}
